---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizedPath } from '@/i18n/utils';
import { getFeaturedProjects, localizedTitleAuto } from '@/lib/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const featured = await getFeaturedProjects();
const featuredItems = await Promise.all(
  featured.map(async (p) => ({ p, title: await localizedTitleAuto(p, lang) }))
);
---

<Base>
  <Hero lang={lang} />

  <Marquee text={t('home.marquee')} />

  <section class="mx-auto max-w-3xl px-5 lg:px-10 py-24 md:py-32">
    {featured.length === 0 ? (
      <p class="text-paper/50 italic text-center">{t('work.no_projects')}</p>
    ) : (
      <div class="flex flex-col gap-6 md:gap-10">
        {featuredItems.map(({ p, title }) => (
          <a
            href={localizedPath(`/work/${p.id}`, lang)}
            class="group block reveal overflow-hidden rounded-2xl bg-paper/5"
            aria-label={title}
          >
            <Image
              src={p.data.cover}
              alt={title}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 768px) calc(100vw - 2.5rem), 48rem"
              format="webp"
              quality={82}
              loading="lazy"
              class="block w-full h-auto transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
            />
          </a>
        ))}
      </div>
    )}

    <div class="mt-12 text-center reveal">
      <a
        href={localizedPath('/work', lang)}
        class="group inline-flex items-center gap-2 text-paper/80 hover:text-magenta-500 transition-colors font-medium"
      >
        {t('home.view_all')}
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>

  <!-- About teaser -->
  <section class="mx-auto max-w-7xl px-5 lg:px-10 py-24 md:py-32 border-t border-paper/10">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5 reveal">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-fire-500 mb-3">◆ {t('home.about_eyebrow')}</p>
        <h2 class="font-display text-4xl md:text-6xl font-semibold tracking-tight leading-[0.95]">
          {t('home.about_title')}
        </h2>
      </div>
      <div class="md:col-span-7 reveal">
        <p class="text-xl md:text-2xl text-paper/85 leading-relaxed">
          {t('home.about_text')}
        </p>
        <a
          href={localizedPath('/about', lang)}
          class="mt-8 inline-flex items-center gap-3 px-6 py-3 rounded-full border border-paper/30 hover:border-fire-500 hover:text-fire-500 transition-colors"
        >
          {t('home.about_cta')}
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</Base>
