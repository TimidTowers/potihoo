---
import Base from '@/layouts/Base.astro';
import { getLangFromUrl, useTranslations, type Lang } from '@/i18n/utils';
import { getSettings } from '@/lib/settings';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { email, socials } = await getSettings();
---

<Base title={t('contact.title')}>
  <section class="mx-auto max-w-7xl px-5 lg:px-10 py-16 md:py-24 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-fire-500 mb-4">◆ {t('contact.title')}</p>
    <h1 class="font-display text-5xl md:text-7xl font-semibold tracking-tight leading-[0.95] overflow-visible">
      <span class="text-gradient italic inline-block pr-[0.15em]">{t('contact.title').split(' ')[0]}</span>
      {t('contact.title').split(' ').slice(1).join(' ') && (
        <span class="block text-paper">{t('contact.title').split(' ').slice(1).join(' ')}</span>
      )}
    </h1>
    <p class="mt-8 mx-auto max-w-2xl text-lg md:text-xl text-paper/75">{t('contact.subtitle')}</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 lg:px-10 grid md:grid-cols-12 gap-10 md:gap-16 pb-20">
    <div class="md:col-span-5 space-y-10 reveal">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-sun-500 mb-3">{t('contact.email_label')}</p>
        <a href={`mailto:${email}`} class="font-display text-3xl md:text-4xl hover:text-magenta-500 transition-colors break-all">
          {email}
        </a>
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-sun-500 mb-3">{t('contact.social_label')}</p>
        <ul class="space-y-3">
          {socials.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-baseline justify-between gap-4 py-2 border-b border-paper/10 hover:border-magenta-500 transition-colors"
              >
                <span class="font-display text-xl group-hover:text-magenta-500 transition-colors">{s.label}</span>
                <span class="text-paper/50 font-mono text-sm">{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <form id="contact-form" class="md:col-span-7 reveal space-y-5" method="POST" data-email={email}>
      <!-- Trampa anti-spam: invisible para personas, tentadora para bots -->
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="absolute -left-[9999px] size-px opacity-0"
      />
      <div class="grid md:grid-cols-2 gap-5">
        <label class="block">
          <span class="block text-xs font-mono uppercase tracking-widest text-paper/60 mb-2">
            {t('contact.form.name')}
          </span>
          <input
            type="text"
            name="name"
            required
            class="w-full bg-transparent border border-paper/20 rounded-xl px-4 py-3 focus:border-magenta-500 focus:outline-none transition-colors placeholder-paper/30"
          />
        </label>
        <label class="block">
          <span class="block text-xs font-mono uppercase tracking-widest text-paper/60 mb-2">
            {t('contact.form.email')}
          </span>
          <input
            type="email"
            name="email"
            required
            class="w-full bg-transparent border border-paper/20 rounded-xl px-4 py-3 focus:border-magenta-500 focus:outline-none transition-colors placeholder-paper/30"
          />
        </label>
      </div>

      <label class="block">
        <span class="block text-xs font-mono uppercase tracking-widest text-paper/60 mb-2">
          {t('contact.form.message')}
        </span>
        <textarea
          name="message"
          rows="6"
          required
          class="w-full bg-transparent border border-paper/20 rounded-xl px-4 py-3 focus:border-magenta-500 focus:outline-none transition-colors placeholder-paper/30 resize-none"
        ></textarea>
      </label>

      <button
        type="submit"
        class="group relative inline-flex items-center gap-3 px-8 py-4 rounded-full bg-magenta-500 text-paper font-medium overflow-hidden transition-transform hover:-translate-y-0.5 disabled:opacity-60"
      >
        <span class="relative z-10" data-submit-label>{t('contact.form.submit')}</span>
        <span class="relative z-10">→</span>
        <span class="absolute inset-0 bg-fire-500 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></span>
      </button>

      <p
        id="form-feedback"
        role="status"
        aria-live="polite"
        class="hidden text-sm"
        data-success={t('contact.form.success')}
        data-error={t('contact.form.error')}
      ></p>
    </form>
  </section>
</Base>

<script>
  // Envío del formulario contra /api/contact. Si el proveedor de correo
  // todavía no está configurado, abrimos el cliente de correo del visitante
  // con el mensaje ya escrito para que nunca quede en la nada.
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const feedback = document.getElementById('form-feedback') as HTMLElement | null;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const label = form.querySelector('[data-submit-label]') as HTMLElement | null;
    const original = label?.textContent ?? '';

    const say = (msg: string, ok: boolean) => {
      if (!feedback) return;
      feedback.textContent = msg;
      feedback.classList.remove('hidden');
      feedback.classList.toggle('text-sun-500', ok);
      feedback.classList.toggle('text-fire-500', !ok);
    };

    const mailtoFallback = (data: Record<string, string>) => {
      const to = form.dataset.email || '';
      const subject = encodeURIComponent(`potihoo · mensaje de ${data.name}`);
      const body = encodeURIComponent(`${data.message}\n\n— ${data.name} (${data.email})`);
      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries()) as Record<string, string>;

      if (button) button.disabled = true;
      if (label) label.textContent = '…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.reset();
          say(feedback?.dataset.success ?? '', true);
        } else {
          const info = await res.json().catch(() => ({}) as { error?: string });
          if (info.error === 'not_configured') {
            mailtoFallback(data);
            say(feedback?.dataset.success ?? '', true);
          } else {
            say(feedback?.dataset.error ?? '', false);
          }
        }
      } catch {
        mailtoFallback(data);
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = original;
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
