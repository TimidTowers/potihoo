---
import Base from '@/layouts/Base.astro';
import WorkGallery from '@/components/WorkGallery.tsx';
import type { GallerySection, GalleryItem } from '@/components/WorkGallery.tsx';
import { getImage } from 'astro:assets';
import { getLangFromUrl, useTranslations, type Lang } from '@/i18n/utils';
import {
  getPublishedProjects,
  localizedTitle,
  localizedDescription,
  localizedCaption,
  CATEGORY_ORDER,
} from '@/lib/projects';
import type { ImageMetadata } from 'astro';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getPublishedProjects();

// Column is capped at ~60rem; mobile shows full width minus page padding.
const SIZES = '(max-width: 640px) calc(100vw - 2.5rem), (max-width: 1024px) 88vw, 60rem';

async function toItem(img: ImageMetadata, title: string, caption: string): Promise<GalleryItem> {
  const opt = await getImage({ src: img, widths: [640, 960, 1280, 1920], format: 'webp', quality: 82 });
  return {
    src: opt.src,
    srcSet: opt.srcSet.attribute,
    sizes: SIZES,
    width: img.width,
    height: img.height,
    title,
    caption,
  };
}

const sections: GallerySection[] = [];
for (const cat of CATEGORY_ORDER) {
  const items: GalleryItem[] = [];
  for (const p of projects.filter((p) => p.data.category === cat)) {
    const title = localizedTitle(p, lang);
    const fallback = localizedDescription(p, lang);
    // Projects without an explicit gallery contribute their cover image.
    if (p.data.gallery.length === 0) {
      items.push(await toItem(p.data.cover, title, fallback));
    } else {
      for (const g of p.data.gallery) {
        items.push(await toItem(g.image, title, localizedCaption(g, lang) ?? fallback));
      }
    }
  }
  sections.push({ id: cat, label: t(`work.categories.${cat}`), items });
}
---

<Base title={t('work.title')}>
  <section class="mx-auto max-w-5xl px-5 lg:px-10 pt-14 pb-6 md:pt-20 md:pb-10">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-fire-500 mb-4">◆ {t('work.title')}</p>
    <h1 class="font-display text-5xl md:text-7xl font-semibold tracking-tighter leading-[0.9]">
      <span class="text-paper">{t('work.title')}</span><span class="text-gradient italic">.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-paper/70">{t('work.subtitle')}</p>
  </section>

  <WorkGallery client:visible sections={sections} emptyLabel={t('work.no_projects')} lang={lang} />
</Base>
