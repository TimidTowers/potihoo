---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizedPath, type Lang } from '@/i18n/utils';
import { getPublishedProjects, localizedTitle, localizedDescription, localizedCaption, categoryPath } from '@/lib/projects';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(project);

const title = localizedTitle(project, lang);
const description = localizedDescription(project, lang);
const cat = t(`work.categories.${project.data.category}`);

const all = await getPublishedProjects();
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
---

<Base title={title} description={description}>
  <article>
    <!-- Hero -->
    <section class="mx-auto max-w-7xl px-5 lg:px-10 pt-12">
      <a
        href={categoryPath(project.data.category, lang)}
        class="inline-flex items-center gap-2 text-sm text-paper/60 hover:text-magenta-500 transition-colors mb-12"
      >
        <span>←</span> {t('work.back')}
      </a>

      <div class="flex flex-wrap gap-2 mb-6">
        <span class="px-3 py-1 rounded-full bg-magenta-500 text-paper text-xs font-mono uppercase tracking-wider">
          {cat}
        </span>
        <span class="px-3 py-1 rounded-full border border-paper/20 text-paper/70 text-xs font-mono">
          {project.data.year}
        </span>
      </div>

      <h1 class="font-display text-5xl md:text-8xl font-semibold tracking-tighter leading-[0.95] max-w-4xl">
        {title}
      </h1>
      <p class="mt-8 max-w-2xl text-xl text-paper/75">{description}</p>
    </section>

    <!-- Cover -->
    <section class="mx-auto max-w-7xl px-5 lg:px-10 mt-16">
      <div class="rounded-3xl overflow-hidden bg-paper/5 reveal">
        {project.data.video ? (
          <video src={project.data.video} class="block w-full h-auto" autoplay muted loop playsinline></video>
        ) : (
          <Image
            src={project.data.cover}
            alt={title}
            widths={[640, 960, 1280, 1920]}
            sizes="(max-width: 768px) calc(100vw - 2.5rem), 72rem"
            format="webp"
            quality={90}
            class="block w-full h-auto"
          />
        )}
      </div>
    </section>

    <!-- Meta + body -->
    <section class="mx-auto max-w-7xl px-5 lg:px-10 grid md:grid-cols-12 gap-10 md:gap-16 py-20">
      <aside class="md:col-span-4 space-y-8">
        {project.data.role && (
          <div class="reveal">
            <p class="font-mono text-xs uppercase tracking-widest text-fire-500 mb-2">{t('work.role')}</p>
            <p class="text-lg">{project.data.role}</p>
          </div>
        )}
        {project.data.client && (
          <div class="reveal">
            <p class="font-mono text-xs uppercase tracking-widest text-fire-500 mb-2">{t('work.client')}</p>
            <p class="text-lg">{project.data.client}</p>
          </div>
        )}
        {project.data.tools.length > 0 && (
          <div class="reveal">
            <p class="font-mono text-xs uppercase tracking-widest text-fire-500 mb-2">{t('work.tools')}</p>
            <ul class="flex flex-wrap gap-2">
              {project.data.tools.map((tool) => (
                <li class="px-3 py-1 rounded-full border border-paper/20 text-sm">{tool}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>

      <div class="md:col-span-8 reveal prose-custom">
        <Content />
      </div>
    </section>

    <!-- Gallery — vertical stack, respects each image's natural ratio -->
    {project.data.gallery.length > 0 && (
      <section class="mx-auto max-w-3xl px-5 lg:px-10 pb-24 flex flex-col gap-6 md:gap-8">
        {project.data.gallery.map((g) => (
          <figure class="reveal">
            <div class="rounded-2xl overflow-hidden bg-paper/5">
              <Image
                src={g.image}
                alt={localizedCaption(g, lang) ?? title}
                widths={[640, 960, 1280, 1920]}
                sizes="(max-width: 768px) calc(100vw - 2.5rem), 48rem"
                format="webp"
                quality={90}
                loading="lazy"
                class="block w-full h-auto"
              />
            </div>
            {localizedCaption(g, lang) && (
              <figcaption class="mt-2 text-sm text-paper/60">{localizedCaption(g, lang)}</figcaption>
            )}
          </figure>
        ))}
      </section>
    )}

    <!-- Next project -->
    {next && next.id !== project.id && (
      <section class="border-t border-paper/10 mx-auto max-w-7xl px-5 lg:px-10 py-20">
        <a href={localizedPath(`/work/${next.id}`, lang)} class="group flex items-center justify-between gap-6">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-paper/50 mb-2">Next →</p>
            <h3 class="font-display text-3xl md:text-5xl font-semibold tracking-tight group-hover:text-gradient transition">
              {localizedTitle(next, lang)}
            </h3>
          </div>
          <span class="size-14 rounded-full bg-sun-500 text-ink grid place-items-center text-xl group-hover:bg-fire-500 group-hover:text-paper group-hover:rotate-45 transition">
            →
          </span>
        </a>
      </section>
    )}
  </article>
</Base>

<style is:global>
  .prose-custom {
    font-size: 1.125rem;
    line-height: 1.8;
    color: rgb(245 241 234 / 0.85);
  }
  .prose-custom h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-paper);
    letter-spacing: -0.02em;
  }
  .prose-custom h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-paper);
  }
  .prose-custom p { margin-bottom: 1.25rem; }
  .prose-custom strong { color: var(--color-sun-500); font-weight: 600; }
  .prose-custom a {
    color: var(--color-magenta-500);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-custom a:hover { color: var(--color-fire-500); }
  .prose-custom ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-custom li { margin-bottom: 0.5rem; }
</style>
