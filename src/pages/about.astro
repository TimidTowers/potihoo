---
import Base from '@/layouts/Base.astro';
import { getLangFromUrl, useTranslations, localizedPath, type Lang } from '@/i18n/utils';
import { getCollection } from 'astro:content';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const aboutEntries = await getCollection('about');
const about = aboutEntries.find((e) => e.data.lang === lang) ?? aboutEntries[0];
const a = about.data;
---

<Base title={t('about.title')}>
  <section class="mx-auto max-w-7xl px-5 lg:px-10 py-16 md:py-24 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-fire-500 mb-4">◆ {t('about.title')}</p>
    <h1 class="font-display text-5xl md:text-7xl font-semibold tracking-tighter leading-[0.95]">
      <span class="text-paper">{a.headline.split('·')[0].trim()}</span>
      {a.headline.includes('·') && (
        <span class="block text-gradient italic">{a.headline.split('·').slice(1).join(' · ').trim()}</span>
      )}
    </h1>
    <p class="mt-8 mx-auto max-w-2xl text-lg md:text-xl text-paper/80 leading-relaxed">
      {a.bio}
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 lg:px-10 grid md:grid-cols-12 gap-10 md:gap-16 py-20 border-t border-paper/10">
    <div class="md:col-span-5 reveal">
      <div class="aspect-[4/5] rounded-3xl overflow-hidden bg-paper/5 sticky top-24">
        {a.portrait ? (
          <img src={a.portrait} alt={a.name} class="size-full object-cover" />
        ) : (
          <div class="size-full grid place-items-center bg-gradient-to-br from-magenta-500 to-fire-500">
            <span class="font-display text-9xl text-paper/40">{a.name.charAt(0)}</span>
          </div>
        )}
      </div>
    </div>
    <div class="md:col-span-7 space-y-16">
      <div class="reveal">
        <h2 class="font-display text-3xl font-semibold mb-4 flex items-center gap-3">
          <span class="size-2 rounded-full bg-magenta-500"></span>
          {t('about.approach_title')}
        </h2>
        <p class="text-xl text-paper/85 leading-relaxed">{a.approach}</p>
      </div>

      <div class="reveal">
        <h2 class="font-display text-3xl font-semibold mb-4 flex items-center gap-3">
          <span class="size-2 rounded-full bg-fire-500"></span>
          {t('about.tools_title')}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {a.tools.map((tool) => (
            <li class="px-4 py-2 rounded-full border border-paper/20 hover:border-sun-500 hover:text-sun-500 transition-colors text-sm">
              {tool}
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal">
        <h2 class="font-display text-3xl font-semibold mb-6 flex items-center gap-3">
          <span class="size-2 rounded-full bg-sun-500"></span>
          {t('about.experience_title')}
        </h2>
        <ul class="space-y-4">
          {a.experience.map((e) => (
            <li class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 py-4 border-b border-paper/10">
              <span class="font-display text-xl text-paper">{e.role}</span>
              <span class="text-paper/60">{e.org}</span>
              <span class="md:ml-auto font-mono text-sm text-paper/50">{e.period}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal">
        <h2 class="font-display text-3xl font-semibold mb-6 flex items-center gap-3">
          <span class="size-2 rounded-full bg-magenta-500"></span>
          {t('about.education_title')}
        </h2>
        <ul class="space-y-4">
          {a.education.map((e) => (
            <li class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 py-4 border-b border-paper/10">
              <span class="font-display text-xl text-paper">{e.title}</span>
              <span class="text-paper/60">{e.org}</span>
              <span class="md:ml-auto font-mono text-sm text-paper/50">{e.period}</span>
            </li>
          ))}
        </ul>
      </div>

      {a.courses.length > 0 && (
        <div class="reveal">
          <h2 class="font-display text-3xl font-semibold mb-6 flex items-center gap-3">
            <span class="size-2 rounded-full bg-fire-500"></span>
            {t('about.courses_title')}
          </h2>
          <ul class="space-y-4">
            {a.courses.map((c) => (
              <li class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 py-4 border-b border-paper/10">
                <span class="font-display text-xl text-paper">{c.title}</span>
                <span class="text-paper/60">{c.org}</span>
                <span class="md:ml-auto font-mono text-sm text-paper/50">{c.period}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {a.languages.length > 0 && (
        <div class="reveal">
          <h2 class="font-display text-3xl font-semibold mb-6 flex items-center gap-3">
            <span class="size-2 rounded-full bg-sun-500"></span>
            {t('about.languages_title')}
          </h2>
          <ul class="flex flex-wrap gap-3">
            {a.languages.map((l) => (
              <li class="px-4 py-2 rounded-full border border-paper/20">
                <span class="text-paper">{l.name}</span>
                <span class="text-paper/50"> — {l.level}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 lg:px-10 py-24 text-center reveal">
    <a
      href={localizedPath('/contact', lang)}
      class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-magenta-500 hover:bg-fire-500 text-paper text-lg font-medium transition-colors"
    >
      {t('about.contact_cta')}
      <span>→</span>
    </a>
  </section>
</Base>
