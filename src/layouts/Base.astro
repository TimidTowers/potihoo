---
import '@/styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import Nav from '@/components/Nav.astro';
import Banner from '@/components/Banner.astro';
import CategoryNav from '@/components/CategoryNav.astro';
import Footer from '@/components/Footer.astro';
import Cursor from '@/components/Cursor.astro';
import { getLangFromUrl, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t('site.tagline'),
  ogImage = '/og-image.jpg',
} = Astro.props;

const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} — ${t('site.tagline')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a0a0a" />

    <!-- SPA-style navigation: animated transitions between pages -->
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-ink text-paper antialiased">
    <Cursor />

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-magenta-500 focus:px-4 focus:py-2 focus:text-paper focus:rounded">
      Skip to content
    </a>

    <Nav />

    <Banner />

    <CategoryNav />

    <main id="main" class="relative" transition:animate={fade({ duration: '0.32s' })}>
      <slot />
    </main>

    <Footer />

    <!-- Smooth scrolling (Lenis) — inertia feel; respects reduced motion -->
    <script>
      import Lenis from 'lenis';

      let lenis;
      const start = () => {
        if (lenis || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        lenis = new Lenis({ lerp: 0.07, smoothWheel: true });
        const raf = (t) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
        // El modal de la galería congela el scroll mientras está abierto
        window.addEventListener('modal:open', () => lenis?.stop());
        window.addEventListener('modal:close', () => lenis?.start());
      };
      document.addEventListener('astro:page-load', start);
      // Tras cada navegación SPA, sincroniza Lenis con la posición real
      document.addEventListener('astro:after-swap', () => {
        requestAnimationFrame(() => lenis?.scrollTo(window.scrollY, { immediate: true, force: true }));
      });
    </script>

    <!-- Scroll reveal — re-runs on every client-side navigation -->
    <script>
      const reveal = () => {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -80px 0px' }
        );
        els.forEach((el) => io.observe(el));
      };
      document.addEventListener('astro:page-load', reveal);
    </script>
  </body>
</html>
