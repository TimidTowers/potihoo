---
// Custom cursor for desktop only — no props.
---
<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"></div>

<script>
  const dot = document.querySelector<HTMLElement>('.cursor-dot');
  const ring = document.querySelector<HTMLElement>('.cursor-ring');
  if (dot && ring && window.matchMedia('(pointer: fine)').matches) {
    let x = 0, y = 0, rx = 0, ry = 0;

    window.addEventListener('mousemove', (e) => {
      x = e.clientX; y = e.clientY;
      dot.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
    });

    const animate = () => {
      rx += (x - rx) * 0.18;
      ry += (y - ry) * 0.18;
      ring.style.transform = `translate(${rx}px, ${ry}px) translate(-50%, -50%)`;
      requestAnimationFrame(animate);
    };
    animate();

    // Event delegation so elements hydrated later (React islands) also trigger the ring
    const hoverables = 'a, button, [role="button"], input, textarea, select, .hoverable';
    document.addEventListener('mouseover', (e) => {
      const target = e.target as Element | null;
      ring.classList.toggle('is-hover', !!target?.closest?.(hoverables));
    });

    document.addEventListener('mouseleave', () => {
      dot.style.opacity = '0';
      ring.style.opacity = '0';
    });
    document.addEventListener('mouseenter', () => {
      dot.style.opacity = '1';
      ring.style.opacity = '1';
    });
  }
</script>
