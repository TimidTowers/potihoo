---
// Banner carrusel global: las imágenes se administran desde el CMS
// ("Ajustes del sitio" → Banner). Se muestra arriba de cada página.
import { getImage } from 'astro:assets';
import BannerCarousel from '@/components/BannerCarousel.tsx';
import { getLangFromUrl, type Lang } from '@/i18n/utils';
import { getSettings } from '@/lib/settings';

const lang: Lang = getLangFromUrl(Astro.url);
const settings = await getSettings();

const slides = await Promise.all(
  settings.banner.map(async ({ image, alt }) => {
    const opt = await getImage({ src: image, widths: [768, 1280, 1920], format: 'webp', quality: 85 });
    return {
      src: opt.src,
      srcSet: opt.srcSet.attribute,
      width: image.width,
      height: image.height,
      alt: alt ?? 'potihoo',
    };
  })
);
---

{slides.length > 0 && (
  <BannerCarousel
    client:visible
    transition:persist="site-banner"
    slides={slides}
    lang={lang}
  />
)}
