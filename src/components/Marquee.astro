---
interface Props {
  text: string;
  variant?: 'default' | 'outline';
}
const { text, variant = 'default' } = Astro.props;
const items = Array.from({ length: 4 });
---

<div class="overflow-hidden border-y border-paper/10 py-4 bg-magenta-500">
  <div class="flex whitespace-nowrap will-change-transform animate-marquee">
    {items.map(() => (
      <span
        class:list={[
          'font-display text-lg md:text-2xl font-semibold tracking-tight px-4 flex items-center gap-4',
          variant === 'outline' ? 'text-stroke' : 'text-paper',
        ]}
      >
        {text}
        <span class="inline-block size-1.5 rounded-full bg-sun-500"></span>
      </span>
    ))}
  </div>
</div>
