---
interface Props {
  text: string;
  variant?: 'default' | 'outline';
}
const { text, variant = 'default' } = Astro.props;
const items = Array.from({ length: 4 });
---

<div class="overflow-hidden border-y border-paper/10 py-6 bg-magenta-500">
  <div class="flex whitespace-nowrap will-change-transform animate-marquee">
    {items.map(() => (
      <span
        class:list={[
          'font-display text-2xl md:text-4xl font-semibold tracking-tight px-6 flex items-center gap-6',
          variant === 'outline' ? 'text-stroke' : 'text-paper',
        ]}
      >
        {text}
        <span class="inline-block size-2 rounded-full bg-sun-500"></span>
      </span>
    ))}
  </div>
</div>
