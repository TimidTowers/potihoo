---
// Barra superior mínima: solo logo + selector de idioma.
// Las secciones (categorías, Sobre mí, Contacto) viven en CategoryNav,
// que se muestra debajo del banner.
import { getLangFromUrl, localizedPath, stripLocaleFromPath, languages, type Lang } from '@/i18n/utils';
import { CATEGORY_ORDER, CATEGORY_SLUGS, categoryPath } from '@/lib/projects';

const lang: Lang = getLangFromUrl(Astro.url);
const currentBase = stripLocaleFromPath(Astro.url.pathname);

// El switcher de idioma traduce también los slugs de categoría
// (/personajes ↔ /en/characters), no solo el prefijo /en.
const seg = currentBase.split('/').filter(Boolean)[0] ?? '';
const catFromSlug = CATEGORY_ORDER.find(
  (c) => CATEGORY_SLUGS.es[c] === seg || CATEGORY_SLUGS.en[c] === seg
);
const langSwitchPath = (code: Lang) =>
  catFromSlug ? categoryPath(catFromSlug, code) : localizedPath(currentBase, code);
---

<header class="fixed top-0 left-0 right-0 z-40 backdrop-blur-md bg-ink/60 border-b border-paper/5">
  <nav class="mx-auto max-w-7xl px-5 lg:px-10 py-4 flex items-center justify-between gap-6">
    <a href={localizedPath('/', lang)} class="group flex items-center gap-2 font-display text-xl font-semibold tracking-tight">
      <span class="inline-block size-3 rounded-full bg-magenta-500 group-hover:bg-fire-500 transition-colors"></span>
      <span>potihoo</span>
      <span class="text-magenta-500 group-hover:text-fire-500 transition-colors">.</span>
    </a>

    <div class="flex items-center gap-2 text-xs font-mono">
      {(Object.keys(languages) as Lang[]).map((code) => (
        <a
          href={langSwitchPath(code)}
          class:list={[
            'uppercase px-2 py-1 rounded transition-colors',
            lang === code ? 'bg-magenta-500 text-paper' : 'text-paper/60 hover:text-paper',
          ]}
          aria-current={lang === code ? 'true' : 'false'}
        >
          {code}
        </a>
      ))}
    </div>
  </nav>
</header>

<div class="h-[60px]"></div>
