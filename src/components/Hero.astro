---
import { useTranslations, localizedPath, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-[88vh] flex items-center overflow-hidden bg-noise">
  <!-- Animated background blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-32 -left-32 size-[480px] rounded-full bg-magenta-500 blur-[120px] opacity-50 animate-blob"></div>
    <div class="absolute top-40 -right-32 size-[420px] rounded-full bg-fire-500 blur-[120px] opacity-40 animate-blob" style="animation-delay: -4s;"></div>
    <div class="absolute -bottom-40 left-1/3 size-[380px] rounded-full bg-sun-500 blur-[120px] opacity-25 animate-blob" style="animation-delay: -8s;"></div>
  </div>

  <div class="mx-auto max-w-7xl w-full px-5 lg:px-10 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-sun-500 mb-6">
      ◆ {t('home.hero_eyebrow')}
    </p>

    <h1 class="font-display font-semibold tracking-tighter leading-[0.9]">
      <span class="block text-6xl md:text-8xl lg:text-[10rem] text-paper">
        {t('home.hero_title_1')}
      </span>
      <span class="block text-6xl md:text-8xl lg:text-[10rem]">
        <span class="text-gradient italic">{t('home.hero_title_2')}</span>
      </span>
    </h1>

    <p class="mt-10 max-w-xl text-lg md:text-xl text-paper/80 leading-relaxed">
      {t('home.hero_subtitle')}
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href={localizedPath('/work', lang)}
        class="group relative inline-flex items-center gap-3 px-7 py-4 rounded-full bg-magenta-500 text-paper font-medium overflow-hidden transition-transform hover:-translate-y-0.5"
      >
        <span class="relative z-10">{t('home.hero_cta_work')}</span>
        <span class="relative z-10 size-2 rounded-full bg-sun-500"></span>
        <span class="absolute inset-0 bg-fire-500 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></span>
      </a>
      <a
        href={localizedPath('/contact', lang)}
        class="group inline-flex items-center gap-3 px-7 py-4 rounded-full border border-paper/30 text-paper font-medium transition-all hover:border-sun-500 hover:text-sun-500"
      >
        {t('home.hero_cta_contact')}
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-paper/40 text-xs font-mono">
    <span class="block w-px h-10 bg-gradient-to-b from-transparent to-paper/40"></span>
    <span class="uppercase tracking-widest">scroll</span>
  </div>
</section>
